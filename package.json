{
  "name": "ptt-tools",
  "version": "1.0.0",
  "description": "Tools for ptt",
  "scripts": {
    "setup:firebase-config": "node -e \"const fs=require('fs'),p='public/firebase-config.js',s='public/firebase-config.sample.js';if(fs.existsSync(p)){console.log(p+' 已存在');process.exit(0);}fs.copyFileSync(s,p);console.log('已建立 '+p+'，請填入 Console 的 Web 設定');\"",
    "predeploy": "node scripts/ensure-firebase-config.js",
    "test": "cross-env NODE_ENV=develop node runPost.js",
    "deploy": "cross-env NODE_ENV=prodcution firebase deploy --only hosting",
    "mcp": "node mcp-server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1",
    "iconv-lite": "^0.7.0",
    "mysql2": "^3.15.2",
    "node-pty": "^1.0.0",
    "node-schedule": "^2.1.1",
    "openai": "^6.6.0",
    "ssh2": "^1.17.0",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
